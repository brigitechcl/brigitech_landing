---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";

const productos = (await getCollection("productos", ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden || a.data.nombre.localeCompare(b.data.nombre, "es"));
const categorias = [...new Set(productos.map(({ data }) => data.categoria))].sort((a, b) => a.localeCompare(b, "es"));
const hayEjemplos = productos.some(({ data }) => data.ejemplo);
---
<Layout title="Productos | Brigitech" description="Explora el catálogo de productos de Brigitech y encuentra soluciones digitales para tu negocio.">
  <Header />
  <main id="contenido" class="catalog-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Productos</span></nav>
      <header class="catalog-heading" data-reveal>
        <div>
          <p class="eyebrow">Catálogo de productos</p>
          <h1>Encuentra tu próxima<br /><span>solución digital.</span></h1>
          <!-- <p class="section-copy">Explora nuestros productos y descubre una forma más simple de llevar tu negocio al siguiente nivel.</p> -->
        </div>
        <a href="/#contacto" class="catalog-help">¿Necesitas algo a medida?<span>Hablemos de tu idea <Icon name="arrow-up" size={16} /></span></a>
      </header>

      <section class="catalog" aria-label="Catálogo de productos">
        <form class="catalog-controls" role="search" aria-label="Buscar productos" hidden>
          <div class="search-field">
            <label for="buscar-producto">Buscar producto</label>
            <input id="buscar-producto" name="buscar" type="search" placeholder="Nombre, característica…" autocomplete="off" />
          </div>
          <div class="category-field">
            <label for="categoria-producto">Categoría</label>
            <select id="categoria-producto" name="categoria"><option value="">Todas las categorías</option>{categorias.map((categoria) => <option value={categoria}>{categoria}</option>)}</select>
          </div>
        </form>
        <div class="catalog-meta">
          <p id="catalog-count" role="status" aria-live="polite" aria-atomic="true">{productos.length} {productos.length === 1 ? "producto" : "productos"}</p>
          <span>Diseño y tecnología, por Brigitech</span>
        </div>
        {hayEjemplos && <p class="examples-note">Catálogo en preparación. Los productos marcados como ejemplo son ilustrativos y no representan una oferta disponible.</p>}
        <div class="products-grid" id="productos-lista">
          {productos.map((producto, index) => <ProductCard producto={producto} numero={index + 1} />)}
        </div>
        <div class="empty-state" id="sin-resultados" hidden={productos.length > 0}>
          <span class="empty-icon"><Icon name="layers" size={28} /></span>
          <h2>{productos.length ? "No encontramos productos" : "Estamos preparando nuestro catálogo"}</h2>
          <p>{productos.length ? "Prueba con otra búsqueda o selecciona una categoría diferente." : "Pronto podrás conocer nuestros productos. Mientras tanto, cuéntanos qué necesitas."}</p>
          {productos.length ? <button type="button" id="limpiar-filtros" class="button button-secondary">Limpiar filtros <Icon name="arrow" size={16} /></button> : <a href="/#contacto" class="button button-secondary">Conversemos <Icon name="arrow" size={16} /></a>}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .catalog-page { padding-bottom: 6rem; background: radial-gradient(ellipse at 85% 0%, #168cff09, transparent 35%); }
  .breadcrumbs { display: flex; align-items: center; gap: .75rem; padding-top: 2rem; color: #657b96; font-size: .75rem; }
  .breadcrumbs a { color: var(--muted); transition: color .2s; }
  .breadcrumbs a:hover { color: var(--cyan); }
  .breadcrumbs [aria-current] { color: #c4d2e4; }
  .catalog-heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; padding-block: 3.5rem; }
  h1 { margin-top: 1.1rem; font-size: clamp(2.5rem, 4.5vw, 3.7rem); line-height: 1.1; letter-spacing: -.055em; font-weight: 600; }
  h1 span { color: #7cbbec; }
  .catalog-heading .section-copy { max-width: 35rem; margin-top: 1.25rem; font-size: .95rem; }
  .catalog-help { flex-shrink: 0; padding-left: 1.5rem; border-left: 1px solid #168cff45; color: var(--muted); font-size: .75rem; line-height: 1.8; }
  .catalog-help span { display: flex; align-items: center; gap: 1rem; margin-top: .35rem; color: #d2e5f7; font-size: .8rem; transition: color .2s; }
  .catalog-help:hover span { color: var(--cyan); }
  .catalog-controls { display: flex; gap: 1rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: .6rem; background: #0b121c; }
  .search-field { flex: 1; }
  .category-field { width: 17rem; }
  label { display: block; margin-bottom: .55rem; color: #b8c7db; font-size: .72rem; }
  input, select { width: 100%; min-height: 46px; border: 1px solid #ffffff20; border-radius: .35rem; padding: .7rem .85rem; background: #080f18; color: var(--text); font-size: .85rem; }
  input::placeholder { color: #71829b; }
  .catalog-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-block: 1.75rem 1.25rem; color: #bac9dc; font-size: .75rem; }
  .catalog-meta > span { color: #6f849e; font-size: .68rem; }
  .examples-note { padding: .8rem 1rem; margin-bottom: 1.25rem; border-left: 2px solid #168cff60; background: #168cff08; color: #9bacc1; font-size: .75rem; line-height: 1.7; }
  .products-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .empty-state { display: grid; justify-items: center; text-align: center; padding: 4rem 1.5rem; border: 1px dashed #ffffff20; border-radius: .75rem; }
  .empty-icon { display: grid; place-items: center; width: 60px; height: 60px; margin-bottom: 1.5rem; color: #70c6ff; background: #168cff12; border: 1px solid #168cff30; border-radius: .75rem; }
  .empty-state h2 { font-size: 1.4rem; letter-spacing: -.035em; }
  .empty-state p { max-width: 28rem; margin-block: .75rem 1.5rem; font-size: .875rem; line-height: 1.8; color: var(--muted); }
  @media (max-width: 1023px) { .products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .catalog-heading { flex-direction: column; align-items: start; gap: 1.75rem; padding-block: 2.5rem; }
    .catalog-help { padding-left: 1rem; }
    .catalog-controls { flex-direction: column; padding: 1rem; }
    .category-field { width: 100%; }
    .catalog-page { padding-bottom: 4rem; }
    .catalog-meta > span { display: none; }
  }
  @media (max-width: 639px) { .products-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const controls = document.querySelector<HTMLFormElement>(".catalog-controls");
  const search = document.querySelector<HTMLInputElement>("#buscar-producto");
  const category = document.querySelector<HTMLSelectElement>("#categoria-producto");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product]"));
  const count = document.getElementById("catalog-count");
  const empty = document.getElementById("sin-resultados");
  const reset = document.getElementById("limpiar-filtros");
  const normalize = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("es");

  function filterProducts() {
    if (!search || !category || !count || !empty) return;
    const terms = normalize(search.value).trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    cards.forEach((card) => {
      const text = normalize(card.dataset.search ?? "");
      card.hidden = !(terms.every((term) => text.includes(term)) && (!category.value || card.dataset.category === category.value));
      if (!card.hidden) visible++;
    });
    count.textContent = `${visible} ${visible === 1 ? "producto" : "productos"}${visible !== cards.length ? ` de ${cards.length}` : ""}`;
    empty.hidden = visible > 0;
  }

  if (controls && search && category) {
    controls.hidden = false;
    controls.addEventListener("submit", (event) => event.preventDefault());
    search.addEventListener("input", filterProducts);
    category.addEventListener("change", filterProducts);
    reset?.addEventListener("click", () => {
      search.value = "";
      category.value = "";
      filterProducts();
      search.focus();
    });
    filterProducts();
  }

  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!motionPreference.matches && "IntersectionObserver" in window) {
    const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.remove("reveal-pending");
        entry.target.classList.add("reveal-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0, rootMargin: "0px 0px -24px 0px" });
    elements.forEach((element) => {
      if (element.getBoundingClientRect().top >= window.innerHeight) element.classList.add("reveal-pending");
      observer.observe(element);
    });
    motionPreference.addEventListener("change", (event) => {
      if (!event.matches) return;
      observer.disconnect();
      elements.forEach((element) => element.classList.remove("reveal-pending"));
    });
  }
</script>
