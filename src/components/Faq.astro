---
import Icon from "./Icon.astro";
const preguntas = [
  { pregunta: "¿Cuánto cuesta desarrollar un sistema?", respuesta: "Depende del alcance y de las integraciones que necesites. Después de una primera conversación, te enviamos una propuesta con costo, plazos y entregables definidos. Así puedes decidir con toda la información." },
  { pregunta: "¿Cuánto se demora un proyecto?", respuesta: "Un sitio web puede estar listo en pocas semanas; un sistema a medida suele tomar de uno a varios meses. Definimos los plazos antes de comenzar y trabajamos por etapas para que puedas ver avances durante el desarrollo." },
  { pregunta: "¿Necesito tener clara toda la idea?", respuesta: "No. Podemos empezar por el problema que quieres resolver. Te ayudamos a ordenar las necesidades, priorizar lo importante y definir una primera versión que tenga sentido para tu negocio." },
  { pregunta: "¿El código y los datos son míos?", respuesta: "Sí. Al terminar el proyecto te entregamos el código fuente y el acceso a todos tus datos. Tu negocio mantiene el control sobre lo que construimos." },
  { pregunta: "¿Pueden conectar los sistemas que ya uso?", respuesta: "Sí. Integramos plataformas de pago, facturación electrónica, ERPs y otras herramientas mediante sus APIs. Primero revisamos las posibilidades de cada plataforma para proponerte una integración viable." },
  { pregunta: "¿Qué pasa después del lanzamiento?", respuesta: "Podemos acompañarte con mantenimiento, soporte y nuevas funcionalidades. Definimos juntos qué nivel de continuidad necesita tu plataforma para seguir funcionando y creciendo." },
];
---
<section id="preguntas" class="faq-section section" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="faq-intro"><h2 id="faq-title" class="section-title">Preguntas frecuentes.</h2><p class="section-copy">Sabemos que desarrollar un proyecto puede generar dudas. Queremos que tomes decisiones con confianza.</p><a href="#contacto" class="text-link">¿Tienes otra pregunta?<Icon name="arrow-up" size={17} /></a></div>
    <div class="faq-list">
      {preguntas.map((p, i) => (
        <details name="preguntas-brigitech"><summary>
          {/* <span class="faq-number">0{i + 1}</span> */}
          <span>{p.pregunta}</span><span class="faq-plus"><Icon name="plus" size={18} /></span>
          </summary><div class="faq-answer"><div><p>{p.respuesta}</p></div></div></details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section { border-top: 1px solid var(--line); background: #080f18; }
  .faq-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 6rem; }
  .section-title { margin-top: 1.3rem; font-size: clamp(2.1rem, 3.5vw, 3rem); }
  .section-copy { margin-top: 1.5rem; max-width: 21rem; font-size: .9rem; }
  .text-link { margin-top: 1.8rem; color: #7bc7ff; }
  details { border-bottom: 1px solid #ffffff12; }
  details:first-child { border-top: 1px solid #ffffff12; }
  summary { display: flex; align-items: center; gap: 1rem; list-style: none; padding: 1.5rem 0; font-size: .88rem; line-height: 1.6; }
  summary::-webkit-details-marker { display: none; }
  .faq-number { font: .55rem monospace; color: #7890ab; }
  .faq-plus { display: inline-flex; margin-left: auto; color: #6893b8; transition: transform .2s; }
  details[open] .faq-plus { transform: rotate(45deg); color: var(--cyan); }
  details[open] summary { color: #8dd7ff; }
  .faq-answer { color: var(--muted); font-size: .9rem; line-height: 1.85; }
  .faq-answer > div { overflow: hidden; }
  .faq-answer p { padding: 0 2rem 1.5rem; }
  @supports (interpolate-size: allow-keywords) {
    details { interpolate-size: allow-keywords; }
    details::details-content { height: 0; overflow: clip; transition: height .35s ease, content-visibility .35s allow-discrete; }
    details[open]::details-content { height: auto; }
  }
  @media (max-width: 1023px) { .faq-layout { gap: 3rem; } }
  @media (max-width: 767px) { .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; } .section-copy { max-width: 30rem; } summary { font-size: .82rem; gap: .75rem; } .faq-answer p { padding-inline: 1.5rem; } }
</style>
