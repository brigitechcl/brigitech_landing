---
// Cambia por tu correo real
const correo = "contacto@brigitech.com";
---
<!-- id="contacto" es el destino del botón del Hero -->
<section id="contacto" class="mx-auto max-w-5xl px-6 py-20 text-center">
  <h2 class="text-3xl font-bold">Contáctanos</h2>
  <p class="mt-4 text-slate-300">Cuéntanos tu proyecto.</p>
  <a href={`mailto:${correo}`} class="mt-6 inline-block text-cyan-400 underline">
    {correo}
  </a>
</section>