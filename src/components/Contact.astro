---
import Icon from "./Icon.astro";
const correo = "brigitechcl@gmail.com";
---
<section id="contacto" class="section contact-section" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <div class="contact-intro">
      <h2 id="contact-title">Las buenas soluciones<br />empiezan aquí.<br /><span>Contáctanos.</span></h2>
      <div class="contact-channels">
        <a href={`mailto:${correo}`} class="contact-channel"><span class="channel-icon"><Icon name="mail" size={20} /></span><span><small>ESCRÍBENOS POR CORREO</small>{correo}</span><Icon name="arrow-up" size={18} /></a>
        <a href="https://www.instagram.com/brigitechcl/" class="contact-channel" target="_blank" rel="noopener noreferrer" aria-label="Contáctanos por Instagram: @brigitechcl (se abre en una nueva pestaña)">
          <span class="channel-icon"><Icon name="instagram" size={20} /></span>
          <span><small>CONVERSEMOS POR INSTAGRAM</small>@brigitechcl</span>
          <Icon name="arrow-up" size={18} />
        </a>
        <a href="https://www.facebook.com/profile.php?id=61595154667287" class="contact-channel" target="_blank" rel="noopener noreferrer" aria-label="Contáctanos por Facebook (se abre en una nueva pestaña)">
          <span class="channel-icon"><Icon name="facebook" size={20} /></span>
          <span><small>CONVERSEMOS POR FACEBOOK</small>Brigitech CL</span>
          <Icon name="arrow-up" size={18} />
        </a>
      </div>
    </div>
    <div class="contact-card">
      <div class="form-heading"><span class="form-label">HABLEMOS DE TU IDEA</span><span class="form-mark" aria-hidden="true">↗</span></div>
      <form id="form-contacto" data-correo={correo}>
        <div class="form-row"><label>Tu nombre <input name="nombre" autocomplete="name" placeholder="¿Cómo te llamas?" required maxlength="120" /></label><label>Empresa <span class="optional">(opcional)</span><input name="empresa" autocomplete="organization" placeholder="Nombre de tu empresa" maxlength="160" /></label></div>
        <label>¿En qué te podemos ayudar?<select name="servicio" required><option value="" disabled selected>Selecciona un servicio</option><option>Desarrollo web</option><option>Software a medida</option><option>App móvil</option><option>Integraciones y APIs</option><option>Ecommerce</option><option>Soporte y evolución</option><option>Quiero orientación</option></select></label>
        <label>Cuéntanos un poco más<textarea name="mensaje" rows="4" placeholder="¿Qué te gustaría construir o mejorar?" required maxlength="5000"></textarea></label>
        <button type="submit" class="button button-primary">Preparar mi correo <Icon name="arrow-up" size={18} /></button>
        <p class="form-note">Se abrirá tu aplicación de correo con el mensaje preparado. No se envía automáticamente.</p>
        <p id="estado-contacto" class="form-status" role="status" hidden>Tu mensaje está preparado. Si no se abrió tu aplicación de correo, escríbenos a <a href={`mailto:${correo}`}>{correo}</a>.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section { position: relative; border-top: 1px solid var(--line); background: radial-gradient(ellipse at 10% 100%, #0c4a7b12, transparent 55%); }
  .contact-layout { display: grid; grid-template-columns: 1.1fr 1fr; align-items: start; gap: 5rem; }
  .contact-intro { padding-top: 1rem; }
  h2 { margin-top: 1.5rem; font-size: clamp(2.2rem, 3.8vw, 3.6rem); line-height: 1.15; letter-spacing: -.055em; font-weight: 500; }
  h2 > span { color: var(--cyan); }
  .contact-channels { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .contact-channel { display: flex; align-items: center; gap: 1rem; width: fit-content; color: #e0edfa; font-size: .95rem; transition: color .2s; }
  .contact-channel:hover { color: var(--cyan); }
  .channel-icon { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; border: 1px solid #168cff33; border-radius: .5rem; color: #64bdff; background: #168cff09; }
  .contact-channel small { display: block; font: .75rem monospace; letter-spacing: .12em; color: #8198b1; margin-bottom: .4rem; }
  .contact-channel > :global(svg) { margin-left: .5rem; color: #7497b8; }
  .contact-card { background: #0d1622; border: 1px solid #ffffff13; border-radius: .75rem; padding: 2rem; }
  .form-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
  .form-label { color: #adbed0; font: .88rem monospace; letter-spacing: .13em; }
  .form-mark { color: #5a91bb; font-size: 1.4rem; }
  form { display: grid; gap: 1.25rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: block; min-width: 0; font-size: .72rem; font-weight: 500; color: #c0cddd; }
  .optional { font-size: .6rem; color: #768ca5; font-weight: 400; }
  input, select, textarea { display: block; width: 100%; min-width: 0; padding: .85rem .9rem; background: #080f18; border: 1px solid #ffffff13; border-radius: .35rem; margin-top: .6rem; color: #d7e7f5; font-size: .78rem; transition: border-color .2s; }
  input::placeholder, textarea::placeholder { color: #61758f; }
  input:focus, select:focus, textarea:focus { border-color: #168cff88; outline: 2px solid #168cff22; outline-offset: 1px; }
  select { min-height: 46px; }
  textarea { resize: vertical; min-height: 110px; }
  .button { width: 100%; justify-content: space-between; margin-top: .2rem; }
  .form-note { font-size: .63rem; color: #7f93aa; line-height: 1.7; text-align: center; }
  .form-status { padding: .8rem; background: #168cff10; color: #b4daf8; border: 1px solid #168cff30; border-radius: .35rem; font-size: .75rem; line-height: 1.7; }
  .form-status a { text-decoration: underline; overflow-wrap: anywhere; }
  @media (max-width: 1023px) { .contact-layout { gap: 2.5rem; } .contact-card { padding: 1.5rem; } .form-row { grid-template-columns: 1fr; gap: 1.25rem; } }
  @media (max-width: 767px) {
    .contact-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    h2 { font-size: clamp(2.15rem, 7vw, 3.6rem); }
    .contact-channel { font-size: .85rem; gap: .7rem; }
    .contact-channel > :global(svg) { margin-left: 0; }
    .form-row { grid-template-columns: 1fr 1fr; }
    input, select, textarea { font-size: 1rem; }
  }
  @media (max-width: 479px) { .form-row { grid-template-columns: 1fr; } .contact-card { padding: 1.25rem; } }
</style>

<script>
  const form = document.getElementById("form-contacto") as HTMLFormElement;
  const estado = document.getElementById("estado-contacto") as HTMLParagraphElement;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const datos = new FormData(form);
    const asunto = `Proyecto: ${datos.get("servicio")}`;
    const cuerpo = [
      `Nombre: ${datos.get("nombre")}`,
      `Empresa: ${datos.get("empresa") || "No indicada"}`,
      "",
      `${datos.get("mensaje")}`,
    ].join("\n");
    estado.hidden = false;
    window.location.href = `mailto:${form.dataset.correo}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
</script>
