---
// El año se actualiza solo
const anio = new Date().getFullYear();
---
<footer class="border-t border-slate-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-slate-400 sm:flex-row">
    <!-- Mismo estilo de nombre que en el header -->
    <span class="wordmark text-2xl">
      <span class="wordmark-brigi">Brigi</span><span class="wordmark-tech">tech</span>
    </span>
    <nav class="flex gap-6">
      <a href="#servicios" class="hover:text-cyan-400">Servicios</a>
      <a href="#proceso" class="hover:text-cyan-400">Cómo trabajamos</a>
      <a href="#contacto" class="hover:text-cyan-400">Contacto</a>
    </nav>
    <span>© {anio} Brigitech. Todos los derechos reservados.</span>
  </div>
</footer>
