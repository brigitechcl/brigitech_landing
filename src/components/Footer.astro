---
import { Image } from "astro:assets";
import texto from "../assets/brigitech-texto-header.png";

// El año se actualiza solo
const anio = new Date().getFullYear();
---
<!-- pb-24 en celulares: deja espacio para que el botón de WhatsApp no tape el texto -->
<footer class="border-t border-slate-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 pt-8 pb-24 text-sm sm:pb-8 text-slate-400 sm:flex-row">
    <Image
      src={texto}
      alt="Brigitech"
      width={352}
      class="h-auto w-44 shrink-0"
    />
    <nav class="flex gap-6">
      <a href="#servicios" class="hover:text-cyan-400">Servicios</a>
      <a href="#proceso" class="hover:text-cyan-400">Cómo trabajamos</a>
      <a href="#contacto" class="hover:text-cyan-400">Contacto</a>
    </nav>
    <span>© {anio} Brigitech. Todos los derechos reservados.</span>
  </div>
</footer>
