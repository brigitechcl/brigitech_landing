---
import { Image } from "astro:assets";
import logo from "../assets/logo-brigitech.webp";

// Textos aquí arriba para cambiarlos fácil sin tocar el HTML
const titulo = "Desarrollamos el software que tu negocio necesita";
const subtitulo = "En Brigitech diseñamos y construimos sitios web, aplicaciones y sistemas a medida, pensados para cómo trabaja tu empresa.";
const textoBoton = "Hablemos";
const textoBotonSecundario = "Ver servicios";
---
<section id="contenido" class="mx-auto max-w-5xl px-6 pt-16 pb-28 text-center">
  <!-- loading="eager": el logo se ve apenas abre la página, no se carga diferido.
       mix-blend-lighten funde el fondo negro del logo con el fondo de la página -->
  <Image
    src={logo}
    alt="Logo de Brigitech"
    width={288}
    height={288}
    loading="eager"
    class="mx-auto mb-8 w-56 mix-blend-lighten sm:w-72"
  />
  <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
    {titulo}
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300">
    {subtitulo}
  </p>
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <!-- El href="#contacto" baja hasta la sección de contacto -->
    <a
      href="#contacto"
      class="rounded-lg bg-cyan-500 px-8 py-3 font-semibold text-slate-950 transition hover:bg-cyan-400"
    >
      {textoBoton}
    </a>
    <a
      href="#servicios"
      class="rounded-lg border border-slate-700 px-8 py-3 font-semibold transition hover:border-cyan-400 hover:text-cyan-400"
    >
      {textoBotonSecundario}
    </a>
  </div>
</section>
