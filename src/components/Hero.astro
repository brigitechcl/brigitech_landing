---
import { Image } from "astro:assets";
import icono from "../assets/brigitech-icono-1024_alpha.png";
import Icon from "./Icon.astro";
---
<section id="contenido" class="hero" aria-labelledby="hero-title" tabindex="-1">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">Software que<br />mueve tu<br /><span>negocio.</span></h1>
      <p class="hero-description">Diseñamos y desarrollamos plataformas web, aplicaciones móviles y software a medida para impulsar tu negocio.</p>
      <div class="hero-actions">
        <a href="#contacto" class="button button-primary">Hablemos de tu proyecto <Icon name="arrow-up" size={18} /></a>
        <a href="#servicios" class="text-link">Explorar servicios <Icon name="arrow" size={17} /></a>
      </div>
    </div>
    <div class="system-visual" role="img" aria-label="Brigitech desarrolla plataformas web, aplicaciones móviles y software a medida para tu negocio">
      <div class="blueprint-grid" aria-hidden="true"></div>
      <!-- <div class="orbit orbit-one" aria-hidden="true"></div> -->
      <!-- <div class="orbit orbit-two" aria-hidden="true"></div> -->
      <svg class="connections" viewBox="0 0 480 450" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <path d="M110 225H155Q175 225 175 205V128Q175 108 195 108H240 M110 225H240 M110 225H155Q175 225 175 245V322Q175 342 195 342H240" stroke="#168cff" stroke-opacity=".55" stroke-dasharray="4 6" />
        <circle r="3" fill="#31c7ef"><animateMotion dur="4s" repeatCount="indefinite" path="M110 225H155Q175 225 175 205V128Q175 108 195 108H240" /></circle>
        <circle r="3" fill="#31c7ef"><animateMotion dur="3s" repeatCount="indefinite" path="M110 225H240" /></circle>
        <circle r="3" fill="#31c7ef"><animateMotion dur="4.5s" repeatCount="indefinite" path="M110 225H155Q175 225 175 245V322Q175 342 195 342H240" /></circle>
      </svg>
      <div class="system-core"><Image src={icono} alt="" width={160} loading="eager" /></div>
      <div class="system-node node-web"><span class="node-icon"><Icon name="code" size={19} /></span><div><strong>Plataformas web</strong><small>Tu negocio en línea</small></div></div>
      <div class="system-node node-ops"><span class="node-icon"><Icon name="layers" size={19} /></span><div><strong>Software a medida</strong><small>Hecho para tus procesos</small></div></div>
      <div class="system-node node-app"><span class="node-icon"><Icon name="phone" size={19} /></span><div><strong>Aplicaciones móviles</strong><small>Tu negocio en movimiento</small></div></div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; border-bottom: 1px solid var(--line); }
  .hero-glow { position: absolute; width: 900px; height: 850px; top: -230px; right: -350px; background: radial-gradient(ellipse, #087bd51a, transparent 65%); pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1.18fr 1fr; align-items: center; gap: 2rem; padding-top: 6rem; padding-bottom: 5.5rem; }
  .hero-copy { position: relative; z-index: 1; }
  .hero-copy .eyebrow { font-size: .64rem; letter-spacing: .14em; color: #aab8c9; }
  .hero-copy .eyebrow::before { display: none; }
  .status-dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px #31c7ef55; }
  h1 { font-size: clamp(3.2rem, 5.7vw, 5.2rem); line-height: 1.09; letter-spacing: -.065em; font-weight: 600; margin-top: 1.9rem; }
  h1 > span { color: var(--cyan); background: linear-gradient(100deg, #30c9ed, #168cff); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-description { margin-top: 1.8rem; max-width: 28rem; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2.1rem; }
  .hero-actions .button { gap: 1rem; }
  .hero-note { display: flex; align-items: center; gap: .45rem; margin-top: 1.2rem; font-size: .7rem; color: #7b8ba1; }
  .hero-note :global(svg) { color: var(--cyan); }
  .system-visual { position: relative; width: 100%; aspect-ratio: 480 / 450; min-width: 0; background: radial-gradient(ellipse at 50% 50%, #0b35662b, transparent 65%); }
  .visual-topline, .visual-bottom { position: absolute; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; color: #6d829a; font: .58rem monospace; letter-spacing: .1em; }
  .visual-topline { top: 0; padding: .9rem 0; border-top: 1px solid #ffffff16; }
  .visual-cross { color: #38648c; font-size: 1.25rem; }
  .visual-bottom { bottom: 0; padding: 1.2rem 0; border-bottom: 1px solid #ffffff16; letter-spacing: .03em; }
  .visual-bottom > span:first-child { display: flex; align-items: center; gap: .6rem; }
  .blueprint-grid { position: absolute; inset: 15% 0 10%; opacity: .25; background-image: radial-gradient(#6b94b8 1px, transparent 1px); background-size: 20px 20px; mask-image: radial-gradient(ellipse, black 30%, transparent 72%); }
  .orbit { position: absolute; border: 1px solid #168cff17; border-radius: 50%; top: 49%; left: 50%; transform: translate(-50%, -50%); }
  .orbit-one { width: 60%; aspect-ratio: 1; }
  .orbit-two { width: 83%; aspect-ratio: 1; border-style: dashed; }
  .connections { position: absolute; width: 100%; height: 100%; inset: 0; }
  .system-core { position: absolute; left: 23%; top: 50%; transform: translate(-50%, -50%) rotate(-8deg); width: 82px; height: 82px; display: grid; place-items: center; border-radius: 24px; border: 1px solid #168cff66; background: linear-gradient(140deg, #11283d, #08121e); box-shadow: 0 0 80px #168cff20, inset 0 0 30px #168cff0d; }
  .system-core :global(img) { width: 88px; height: auto; transform: rotate(8deg); }
  .system-node { position: absolute; left: 50%; right: 0; transform: translateY(-50%); display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border: 1px solid #8ebfff24; background: linear-gradient(125deg, #142335, #0b1420); border-radius: .65rem; box-shadow: 0 12px 40px #0003; }
  .system-node small { display: block; color: #92a7bc; font-size: .62rem; line-height: 1.4; margin-top: .25rem; }
  .system-node strong { display: block; font-weight: 500; font-size: .73rem; white-space: nowrap; }
  .node-icon { display: grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; background: #168cff12; border: 1px solid #168cff22; border-radius: .35rem; color: #43b6ff; }
  .node-web { top: 24%; }
  .node-ops { top: 50%; }
  .node-app { top: 76%; }
  .node-dot { width: 4px; height: 4px; background: var(--cyan); border-radius: 50%; margin-left: .5rem; }
  .visual-corner { position: absolute; width: 14px; height: 14px; border-right: 1px solid #168cff80; border-bottom: 1px solid #168cff80; bottom: -1px; right: 0; }
  .hero-foundation { display: grid; grid-template-columns: 1.15fr 1fr 1fr 1fr; align-items: center; gap: 2rem; border-top: 1px solid var(--line); padding-block: 1.8rem; }
  .hero-foundation p { font-size: .73rem; color: #6e8097; line-height: 1.7; }
  .hero-foundation strong { font-weight: 400; color: #bac5d3; }
  .hero-foundation > div { font-size: .75rem; color: #bbc8d7; }
  .hero-foundation > div > span { color: #718ba5; margin-right: .8rem; font: .6rem monospace; }
  @media (min-width: 1440px) { .hero-grid { padding-block: 7rem; } }
  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 4.5rem; }
    .system-visual { display: none; }
    h1 { font-size: clamp(3rem, 5.5vw, 4.5rem); }
    .hero-foundation { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
  @media (max-width: 767px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 3.5rem; padding-bottom: 2rem; gap: 2.5rem; }
    h1 { font-size: clamp(2.9rem, 9vw, 4.8rem); }
    .hero-description { font-size: .94rem; }
    .hero-actions { gap: 1.4rem; }
    .hero-foundation { padding-block: 1.5rem; gap: 1.2rem; }
    .hero-foundation > div { font-size: .68rem; }
    .hero-foundation > div > span { margin-right: .3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .connections circle { display: none; } }
</style>
