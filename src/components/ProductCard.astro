---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  producto: CollectionEntry<"productos">;
  numero: number;
}

const { producto: { id, data: producto }, numero } = Astro.props;
const consulta = `mailto:brigitechcl@gmail.com?subject=${encodeURIComponent(`Consulta sobre ${producto.nombre}`)}`;
const busqueda = [producto.nombre, producto.resumen, producto.categoria, ...producto.caracteristicas].join(" ");
---
<article class="product-card" data-product data-category={producto.categoria} data-search={busqueda} data-reveal aria-labelledby={`producto-${id}`}>
  <div class="product-preview">
    {producto.imagen ? (
      <img src={producto.imagen.src} alt={producto.imagen.alt} width="720" height="400" loading="lazy" />
    ) : (
      <div class="product-art" aria-hidden="true">
        <div class="art-grid"></div>
        <span class="art-orbit"></span>
        <span class="art-icon"><Icon name={producto.icono} size={44} /></span>
        <span class="art-number">{String(numero).padStart(2, "0")}</span>
        <span class="art-caption">BRIGITECH / PRODUCTOS</span>
      </div>
    )}
    <span class:list={["product-status", { "is-available": !producto.ejemplo && producto.estado === "Disponible" }]}>
      <span aria-hidden="true"></span>{producto.ejemplo ? "Producto de ejemplo" : producto.estado}
    </span>
  </div>
  <div class="product-body">
    <p class="product-category">{producto.categoria}</p>
    <h2 id={`producto-${id}`}>{producto.nombre}</h2>
    <p class="product-description">{producto.resumen}</p>
    <ul class="product-features" aria-label="Características">
      {producto.caracteristicas.map((caracteristica) => <li><Icon name="check" size={15} />{caracteristica}</li>)}
    </ul>
    <a class="product-link" href={producto.enlace ?? consulta} aria-label={`${producto.enlace ? "Conocer producto" : "Consultar producto"}: ${producto.nombre}`}>
      {producto.enlace ? "Conocer producto" : "Consultar producto"}<Icon name="arrow-up" size={18} />
    </a>
  </div>
</article>

<style>
  .product-card { min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: .75rem; background: #0b121c; transition: border-color .25s, transform .25s; }
  .product-card:hover { border-color: #168cff65; transform: translateY(-3px); }
  .product-preview { position: relative; height: 200px; overflow: hidden; border-bottom: 1px solid var(--line); background: #0b1725; }
  .product-preview > img { width: 100%; height: 100%; object-fit: cover; }
  .product-art { position: relative; height: 100%; display: grid; place-items: center; isolation: isolate; background: radial-gradient(ellipse at 50% 80%, #168cff23, transparent 70%); }
  .art-grid { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(#168cff0b 1px, transparent 1px), linear-gradient(90deg, #168cff0b 1px, transparent 1px); background-size: 28px 28px; mask-image: linear-gradient(transparent, black); }
  .art-orbit { position: absolute; width: 156px; height: 156px; border: 1px solid #168cff25; border-radius: 50%; }
  .art-orbit::after { content: ""; position: absolute; width: 6px; height: 6px; top: 22px; right: 16px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 15px #31c7ef88; }
  .art-icon { width: 90px; height: 90px; display: grid; place-items: center; color: #70c6ff; border: 1px solid #168cff45; border-radius: 1.2rem; background: linear-gradient(140deg, #173653, #0c1b2d); box-shadow: 0 12px 40px #00000030; transform: rotate(-8deg); transition: transform .35s; }
  .product-card:hover .art-icon { transform: rotate(0deg) translateY(-3px); }
  .art-number { position: absolute; right: 1.25rem; bottom: 1rem; color: #487092; font: .7rem monospace; }
  .art-caption { position: absolute; left: 1.25rem; bottom: 1rem; color: #487092; font: .5rem monospace; letter-spacing: .12em; }
  .product-status { position: absolute; top: 1rem; left: 1rem; display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .6rem; border: 1px solid #ffffff20; border-radius: .3rem; background: #08111ee8; color: #bdcce0; font-size: .63rem; backdrop-filter: blur(10px); }
  .product-status > span { width: 5px; height: 5px; border-radius: 50%; background: #8fa5be; }
  .is-available { color: #7be2ca; }
  .is-available > span { background: #7be2ca; }
  .product-body { display: flex; flex: 1; flex-direction: column; padding: 1.75rem; }
  .product-category { color: var(--cyan); font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin-top: .75rem; font-size: 1.5rem; font-weight: 500; letter-spacing: -.04em; line-height: 1.25; overflow-wrap: anywhere; }
  .product-description { margin-top: .85rem; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .product-features { display: grid; gap: .65rem; list-style: none; padding: 0; margin: 1.5rem 0 1.75rem; }
  .product-features li { display: flex; align-items: start; gap: .6rem; font-size: .77rem; line-height: 1.5; color: #becbdb; }
  .product-features :global(svg) { color: #55b7ff; margin-top: .1rem; }
  .product-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; border-top: 1px solid var(--line); padding-top: 1.2rem; color: #d2e5f7; font-size: .8rem; font-weight: 500; transition: color .2s; }
  .product-link:hover { color: var(--cyan); }
  @media (max-width: 639px) { .product-body { padding: 1.5rem; } }
</style>
