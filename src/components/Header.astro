---
import { Image } from "astro:assets";
import icono from "../assets/brigitech-icono-1024_alpha.png";
import texto from "../assets/brigitech-texto-header.png";
import Icon from "./Icon.astro";

const homePrefix = Astro.url.pathname === "/" ? "" : "/";
const isProductsPage = /^\/products\/?$/.test(Astro.url.pathname);
const links = [
  { label: "Servicios", href: `${homePrefix}#servicios` },
  { label: "Productos", href: "/products/", active: isProductsPage },
  { label: "Soluciones", href: `${homePrefix}#rubros` },
  { label: "Cómo trabajamos", href: `${homePrefix}#proceso` },
  { label: "Preguntas", href: `${homePrefix}#preguntas` },
];
---
<header class="site-header">
  <a href={isProductsPage ? "#content" : "#contenido"} class="skip-link">Saltar al contenido</a>
  <nav class="container header-inner" aria-label="Navegación principal">
    <a href="/" class="header-logo" aria-label="Brigitech, inicio">
      <span class="header-logo-symbol"><Image src={icono} alt="" width={128} loading="eager" /></span>
      <span class="header-logo-name"><Image src={texto} alt="" width={512} loading="eager" /></span>
    </a>
    <ul class="desktop-menu">
      {links.map((link) => <li><a href={link.href} aria-current={link.active ? "page" : undefined}>{link.label}</a></li>)}
    </ul>
    <div class="header-actions">
      <a href={`${homePrefix}#contacto`} class="header-cta">Conversemos <Icon name="arrow-up" size={15} /></a>
      <button id="boton-menu" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" class="menu-toggle">
        <span class="menu-open-icon"><Icon name="menu" /></span>
        <span class="menu-close-icon"><Icon name="close" /></span>
      </button>
    </div>
  </nav>
  <ul id="menu-movil" hidden class="mobile-menu container">
    {links.map((link) => <li><a href={link.href} aria-current={link.active ? "page" : undefined}>{link.label}<Icon name="arrow-up" size={16} /></a></li>)}
  </ul>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #060b12e8; border-bottom: 1px solid var(--line); backdrop-filter: blur(20px); }
  .header-inner { min-height: 88px; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .desktop-menu { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); margin: 0; padding: 0; list-style: none; }
  .desktop-menu a { font-size: .9rem; white-space: nowrap; color: #abb7c7; transition: color .2s; }
  .desktop-menu a:hover { color: white; }
  .desktop-menu a[aria-current="page"], .mobile-menu a[aria-current="page"] { color: var(--cyan); }
  .header-actions { display: flex; align-items: center; gap: .7rem; }
  .header-cta { display: inline-flex; align-items: center; gap: 1rem; padding: .75rem 1rem; font-size: .78rem; font-weight: 600; background: #168cff12; border: 1px solid #168cff60; border-radius: .35rem; color: #c7e6ff; transition: background .2s; }
  .header-cta:hover { background: #168cff30; }
  .menu-toggle { display: none; width: 40px; height: 40px; align-items: center; justify-content: center; background: transparent; color: white; border: 1px solid var(--line); border-radius: .35rem; }
  .menu-close-icon { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-open-icon { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-close-icon { display: flex; }
  .menu-open-icon { display: flex; }
  .mobile-menu { padding-block: .5rem 1.2rem; list-style: none; }
  .mobile-menu a { display: flex; align-items: center; justify-content: space-between; padding-block: 1rem; border-top: 1px solid var(--line); color: #cbd5e1; font-size: .9rem; }
  .header-logo { display: inline-flex; flex-shrink: 0; align-items: center; gap: .4rem; border-radius: .25rem; }
  .header-logo-symbol, .header-logo-name { position: relative; overflow: hidden; flex-shrink: 0; }
  .header-logo-symbol { width: 1.75rem; height: 1.75rem; }
  .header-logo-name { width: 6rem; height: 1.4375rem; }
  /* Solo se compensan los márgenes transparentes; se conservan los logos originales. */
  .header-logo-symbol img, .header-logo-name img { position: absolute; top: 50%; left: 50%; max-width: none; height: auto; transform: translate(-50%, -50%); }
  .header-logo-symbol img { width: 133.333%; }
  .header-logo-name img { width: 120%; }
  @media (min-width: 640px) {
    .header-logo { gap: .625rem; }
    .header-logo-symbol { width: 2.5rem; height: 2.5rem; }
    .header-logo-name { width: 10rem; height: 2.375rem; }
  }
  @media (max-width: 1023px) {
    .desktop-menu { display: none; }
    .menu-toggle { display: flex; }
    .header-inner { min-height: 76px; gap: .5rem; }
  }
  @media (min-width: 1024px) { .mobile-menu { display: none; } }
  @media (max-width: 639px) {
    .header-inner { min-height: 70px; }
    .header-cta { padding: .65rem .7rem; font-size: .7rem; }
    .header-cta :global(svg) { display: none; }
    .header-actions { gap: .4rem; }
  }
</style>

<script>
  const boton = document.getElementById("boton-menu") as HTMLButtonElement;
  const menu = document.getElementById("menu-movil") as HTMLUListElement;
  function mostrarMenu(abierto: boolean) {
    menu.hidden = !abierto;
    boton.setAttribute("aria-expanded", String(abierto));
    boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
  }
  boton.addEventListener("click", () => mostrarMenu(menu.hasAttribute("hidden")));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) mostrarMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      mostrarMenu(false);
      boton.focus();
    }
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) mostrarMenu(false);
  });
</script>
