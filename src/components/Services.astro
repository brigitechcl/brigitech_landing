---
import Icon from "./Icon.astro";
const servicios = [
  { nombre: "Apps móviles", detalle: "Lleva tu negocio al bolsillo de tus clientes, en Android e iOS.", icono: "phone" as const, etiqueta: "iOS & Android" },
  { nombre: "Ecommerce", detalle: "Una experiencia de compra fluida, desde el catálogo hasta el pago.", icono: "bag" as const, etiqueta: "Comercio digital" },
  { nombre: "Soporte y evolución", detalle: "El lanzamiento es el comienzo. Mantenemos y mejoramos tu software.", icono: "support" as const, etiqueta: "Mejora continua" },
];
---
<section id="servicios" class="section container" aria-labelledby="services-title">
  <div class="section-heading">
    <div><h2 id="services-title" class="section-title">Servicios con propósito.<br />No soluciones genéricas.</h2></div>
    <p class="section-copy">Desde tu primera plataforma hasta el sistema que conecta toda tu operación. Encontramos la solución que tiene sentido para ti.</p>
  </div>
  <div class="services-grid">
    <a href="#contacto" class="service-card service-featured">
      <div class="card-top"><span class="service-icon"><Icon name="layers" size={23} /></span><Icon name="arrow-up" size={21} /></div>
      <h3>Software que trabaja<br />como tu negocio.</h3>
      <p>Sistemas a medida para ordenar tu operación, automatizar lo repetitivo y darle a tu equipo más tiempo para lo importante.</p>
      <div class="workflow" aria-hidden="true"><span><span class="workflow-dot"></span> Tu proceso</span><i></i><span class="workflow-center"><Icon name="code" size={16} /> Software a medida</span><i></i><span><Icon name="check" size={14} /> Más simple</span></div>
      <div class="card-bottom"><span>Software a medida</span></div>
    </a>
    <a href="#contacto" class="service-card service-web">
      <div class="card-top"><span class="service-icon"><Icon name="code" size={23} /></span><Icon name="arrow-up" size={21} /></div>
      <h3>Tu mejor versión.<br />También en la web.</h3>
      <p>Sitios y aplicaciones web que combinan diseño, velocidad y una experiencia que invita a quedarse.</p>
      <div class="web-preview" aria-hidden="true"><div class="preview-toolbar"><i></i><i></i><i></i><span>tu-negocio.cl</span></div><div class="preview-body"><div><span></span><span></span><span></span><b></b></div><div class="preview-art"><span></span></div></div></div>
      <div class="card-bottom"><span>Desarrollo web</span></div>
    </a>
    {servicios.map((s) => (
      <a href="#contacto" class="service-card service-small">
        <div class="card-top"><span class="service-icon"><Icon name={s.icono} size={22} /></span><Icon name="arrow-up" size={18} /></div>
        <h3>{s.nombre}</h3>
        <p>{s.detalle}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .services-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
  .service-card { position: relative; display: flex; flex-direction: column; min-width: 0; padding: 2rem; border: 1px solid #ffffff12; border-radius: .75rem; background: #0b121c; color: var(--text); overflow: hidden; transition: border-color .25s, background .25s, transform .25s; }
  .service-card:hover { border-color: #168cff65; background: #0d1724; transform: translateY(-3px); }
  .service-featured { grid-column: span 7; background: radial-gradient(ellipse at 100% 0%, #168cff12, transparent 70%), #0b1420; }
  .service-web { grid-column: span 5; }
  .card-top { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .card-top > :global(svg) { margin-left: auto; color: #64778e; transition: color .2s; }
  .service-card:hover .card-top > :global(svg) { color: var(--cyan); }
  .service-icon { color: #55b7ff; display: inline-flex; }
  .service-index { font: .55rem monospace; letter-spacing: .1em; color: #7f92aa; }
  h3 { font-size: 1.95rem; font-weight: 500; letter-spacing: -.045em; line-height: 1.2; }
  .service-card p { margin-top: 1rem; color: var(--muted); font-size: .9rem; line-height: 1.8; max-width: 27rem; }
  .workflow { display: flex; align-items: center; justify-content: center; flex: 1; padding-block: 2.8rem; }
  .workflow > span { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid #ffffff14; border-radius: .4rem; background: #101b29; padding: .8rem .6rem; font-size: .65rem; white-space: nowrap; color: #aebdd1; }
  .workflow > .workflow-center { border-color: #168cff50; color: #75c7ff; background: #10243b; }
  .workflow i { width: 1.8rem; height: 1px; background: #168cff55; }
  .workflow-dot { width: 5px; height: 5px; background: #7793b5; border-radius: 50%; }
  .workflow :global(svg) { color: #55b7ff; }
  .card-bottom { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-top: 1.1rem; margin-top: auto; font-size: .65rem; gap: 1rem; }
  .web-preview { border: 1px solid #ffffff13; background: #080f18; border-radius: .45rem .45rem 0 0; margin-top: 1.8rem; margin-bottom: 1.3rem; width: 85%; margin-inline: auto; }
  .preview-toolbar { display: flex; align-items: center; gap: 3px; border-bottom: 1px solid var(--line); padding: .6rem .7rem; }
  .preview-toolbar i { width: 3px; height: 3px; border-radius: 50%; background: #34445a; }
  .preview-toolbar > span { color: #69809e; font: .45rem monospace; margin-left: 1.4rem; }
  .preview-body { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1.2rem; }
  .preview-body > div:first-child > span { display: block; width: 90%; height: 4px; background: #29405a; margin-block: .5rem; }
  .preview-body > div:first-child > span:nth-child(2) { width: 65%; background: #168cff88; }
  .preview-body > div:first-child > span:nth-child(3) { height: 2px; width: 80%; background: #1b2b3e; margin-top: .8rem; }
  .preview-body b { display: block; width: 30px; height: 10px; border-radius: 2px; background: #168cff; margin-top: .75rem; }
  .preview-art { display: grid; place-items: center; background: #0e2136; border: 1px solid #168cff25; border-radius: .25rem; }
  .preview-art > span { width: 38px; height: 38px; transform: rotate(30deg); border: 1px solid #168cff70; background: linear-gradient(120deg, #168cff28, transparent); border-radius: 8px; }
  .service-small { grid-column: span 4; padding: 1.6rem; }
  .service-small .card-top { margin-bottom: 1.5rem; }
  .small-index { position: absolute; top: 5.2rem; right: 1.6rem; font: .6rem monospace; color: #7b91ab; }
  .service-small h3 { font-size: 1.1rem; letter-spacing: -.025em; }
  .service-small p { font-size: .875rem; margin-top: .8rem; margin-bottom: 1.6rem; }
  .service-tag { align-self: start; margin-top: auto; font: .54rem monospace; color: #7f94ad; border: 1px solid #ffffff0c; padding: .35rem .5rem; border-radius: .2rem; }
  @media (max-width: 1023px) {
    .service-featured, .service-web { grid-column: span 6; }
    .service-card { padding: 1.5rem; }
    h3 { font-size: 1.6rem; }
    .workflow { flex-wrap: wrap; gap: .5rem; }
    .workflow i { display: none; }
    .service-index { font-size: .46rem; }
  }
  @media (max-width: 639px) {
    .service-featured, .service-web, .service-small { grid-column: span 12; }
    .service-small { padding: 1.5rem; }
    .service-small h3 { font-size: 1.3rem; }
    .service-small p { max-width: 30rem; }
    .workflow { padding-block: 2rem; gap: .3rem; }
    .workflow > span { font-size: .55rem; padding: .65rem .5rem; }
    .service-small .card-top { margin-bottom: 1.1rem; }
  }
</style>
