---
// Estilos globales (carga Tailwind en todas las páginas)
import "../styles/global.css";

// Props que recibe el layout desde cada página
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<!-- scroll-pt-20 evita que el menú fijo tape el título al saltar a una sección -->
<html lang="es" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Descripción que aparece en Google -->
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <!-- Fuente Exo 2 (gruesa y en cursiva), la más parecida a la del logo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@1,900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <!-- Aquí se inserta el contenido de cada página -->
    <slot />
  </body>
</html>